---
import RequestFormWrapper from './react/RequestFormWrapper';
---

<section
  id="solicitar-cita"
  class="relative z-10 grid grid-cols-12 bg-linear-to-b from-blue-100 via-blue-50 to-white px-5 py-10"
>
  <h2
    class="col-span-12 mx-auto w-fit pb-6 font-bold text-4xl leading-tight text-center text-gray-800 reveal"
  >
    Reserva tu Cita
  </h2>
  <div
    class="col-span-12 grid grid-cols-12 gap-5 reveal reveal-delay-200 w-full"
  >
    <RequestFormWrapper client:load />
  </div>
</section>
